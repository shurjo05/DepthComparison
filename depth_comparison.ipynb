<cell id="cell-21"><cell_type>markdown</cell_type>---
## Save Outputs to Drive</cell>
<cell id="cell-22">import shutil, os

src = "/content/DepthComparison/depth_comparison"
dst = "/content/drive/MyDrive/Corn Seed Dataset/depth_comparison_outputs"

os.makedirs(dst, exist_ok=True)
for item in os.listdir(src):
    s = os.path.join(src, item)
    d = os.path.join(dst, item)
    if os.path.isdir(s):
        if os.path.exists(d):
            shutil.rmtree(d)
        shutil.copytree(s, d)
    else:
        shutil.copy2(s, d)

saved = [f for f in os.listdir(dst) if os.path.isdir(os.path.join(dst, f))]
print(f"✓ Saved to {dst}")
print(f"  Model folders: {saved}")</cell>
